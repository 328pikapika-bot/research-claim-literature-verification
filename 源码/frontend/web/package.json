{
  "name": "claim-consistency-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:nstl": "vite --mode nstl-local --host 0.0.0.0 --port 18094",
    "dev:local-login": "npm run setup:nstl-local && npm run dev:nstl",
